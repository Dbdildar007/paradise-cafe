{
  "name": "paradise-cafe",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx,.js --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify:pins": "node scripts/verify-pins.js",
    "verify:hermes": "bash scripts/verify-hermes-bytecode.sh",
    "e2e:android": "maestro test .maestro/",
    "e2e:ios": "maestro --platform ios test .maestro/",
    "postinstall": "node scripts/postinstall-check.js",
    "test:backend": "deno test --config supabase/functions/deno.json supabase/functions && python3 supabase/tests/run_local_db_tests.py",
    "check:imports": "node scripts/check-imports.js"
  },
  "dependencies": {
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "21.14.0",
    "@react-native-firebase/auth": "21.14.0",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "jail-monkey": "^2.8.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-keychain": "^9.2.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "5.0.0",
    "react-native-screens": "4.4.0",
    "react-native-ssl-public-key-pinning": "^1.2.5",
    "react-native-svg": "15.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  }
}
